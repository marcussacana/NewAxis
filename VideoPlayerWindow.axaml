<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:NewAxis.ViewModels"
        xmlns:controls="using:NewAxis.Controls"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="NewAxis.VideoPlayerWindow"
        x:Name="PlayerRoot"
        x:DataType="vm:VideoPlayerViewModel"
        Title="3D Video Player"
        Width="1280" Height="720"
        Background="#1a1a1a">

  <Design.DataContext>
    <vm:VideoPlayerViewModel/>
  </Design.DataContext>

  <Window.KeyBindings>
    <KeyBinding Gesture="F" Command="{Binding ToggleFullscreenCommand}" />
    <KeyBinding Gesture="F11" Command="{Binding ToggleFullscreenCommand}" />
    <KeyBinding Gesture="Alt+Enter" Command="{Binding ToggleFullscreenCommand}" />
    <KeyBinding Gesture="Right" Command="{Binding SkipForwardCommand}" />
    <KeyBinding Gesture="Left" Command="{Binding SkipBackwardCommand}" />
  </Window.KeyBindings>

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://NewAxis/Resources/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <vm:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
      <vm:BoolToOpacityActiveConverter x:Key="BoolToOpacityActiveConverter" />
      <vm:BoolToAccentIconBrushConverter x:Key="BoolToAccentIconBrushConverter" />
      <vm:StringEqualsConverter x:Key="StringEqualsConverter" />
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Button.PlayButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="60"/>
      <Setter Property="Height" Value="60"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="CornerRadius" Value="30"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="BorderBrush" Value="#ffffff"/>
    </Style>
    <Style Selector="Button.PlayButton:pointerover">
      <Setter Property="Background" Value="#aa007acc"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.StopButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="50"/>
      <Setter Property="Height" Value="50"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="CornerRadius" Value="25"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="BorderBrush" Value="#ffffff"/>
    </Style>
    <Style Selector="Button.StopButton:pointerover">
      <Setter Property="Background" Value="#aaCC0000"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.LoopButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="50"/>
      <Setter Property="Height" Value="50"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="CornerRadius" Value="25"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="BorderBrush" Value="#ffffff"/>
    </Style>
    <Style Selector="Button.LoopButton:pointerover">
      <Setter Property="Background" Value="#aa007acc"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.ControlButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="BorderBrush" Value="#44ffffff"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Padding" Value="5"/>
      <Setter Property="Opacity" Value="0.8"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.ControlButton:pointerover">
      <Setter Property="Opacity" Value="1.0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#99ffffff"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.ControlButton TextBlock">
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.ControlButton:pointerover TextBlock">
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button.ControlButton:pointerover PathIcon">
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="BorderBrush" Value="#44ffffff"/>
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#11ffffff"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="Background" Value="#005a9e"/>
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Background" Value="#3a3a3a"/>
      <Setter Property="Foreground" Value="#666666"/>
      <Setter Property="BorderBrush" Value="#2a2a2a"/>
    </Style>
    <Style Selector="Slider">
      <Setter Property="Background" Value="#24ffffff"/>
      <Setter Property="Foreground" Value="#D6A23A"/>
      <Setter Property="Height" Value="28"/>
    </Style>
    <Style Selector="Slider:pointerover">
      <Setter Property="Foreground" Value="#E6B95C"/>
    </Style>
    <Style Selector="Slider Thumb">
      <Setter Property="Width" Value="14"/>
      <Setter Property="Height" Value="14"/>
      <Setter Property="Background" Value="#FFF2D6"/>
      <Setter Property="BorderBrush" Value="#B9851D"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Slider Thumb:pointerover">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#D6A23A"/>
    </Style>
    <Style Selector="Slider /template/ RepeatButton#PART_DecreaseButton">
      <Setter Property="Background" Value="{Binding $parent[Slider].Foreground}"/>
    </Style>
    <Style Selector="Slider /template/ RepeatButton#PART_IncreaseButton">
      <Setter Property="Background" Value="{Binding $parent[Slider].Background}"/>
    </Style>

    <Style Selector="Slider.VolumeSlider /template/ RepeatButton#PART_DecreaseButton">
      <Setter Property="Height" Value="8"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Slider.VolumeSlider /template/ RepeatButton#PART_IncreaseButton">
      <Setter Property="Height" Value="8"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Slider.VolumeSlider Thumb">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
    </Style>
  </Window.Styles>

  <Panel PointerMoved="ControlPanel_PointerMoved" PointerPressed="ControlPanel_PointerPressed" Background="Transparent">

    <controls:VideoPlayerControl x:Name="VideoPlayer" IsHitTestVisible="False" />

    <Border VerticalAlignment="Bottom"
            Margin="40"
            CornerRadius="12"
            Padding="20,15"
            Opacity="{Binding IsControlsVisible, Converter={StaticResource BoolToOpacityConverter}}"
            IsEnabled="{Binding IsControlsVisible}"
            IsHitTestVisible="{Binding IsControlsVisible}">
      <Border.Transitions>
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut" />
        </Transitions>
      </Border.Transitions>
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
          <GradientStop Offset="0" Color="#991a1a1a" />
          <GradientStop Offset="1" Color="#cc000000" />
        </LinearGradientBrush>
      </Border.Background>

      <StackPanel Spacing="10">
        <DockPanel>
          <TextBlock Text="{Binding StatusMessage}" Foreground="#4CAF50" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>

        <Slider Minimum="0"
                Maximum="{Binding DurationSeconds}"
                Value="{Binding PositionSeconds}"
                IsSnapToTickEnabled="False"
                Height="20"
                Margin="0,-5,0,0"/>

        <Grid ColumnDefinitions="Auto,*,Auto">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
             <Button Command="{Binding OpenFileCommand}" Classes="ControlButton">
               <PathIcon Data="{StaticResource OpenIcon}" Width="16" Height="16" Foreground="White"/>
             </Button>
             <Button Command="{Binding Toggle3DCommand}" Classes="ControlButton">
               <TextBlock Text="{Binding StereoButtonLabel}" FontSize="11" FontWeight="Bold" Foreground="White"/>
             </Button>

             <Separator Width="1" Height="20" Background="#33ffffff" Margin="4,0"/>

             <Button Command="{Binding SpeedDownCommand}" Classes="ControlButton">
               <PathIcon Data="{StaticResource SpeedDownIcon}" Width="14" Height="14" Foreground="White"/>
             </Button>
             <TextBlock Text="{Binding PlaybackSpeed, StringFormat={}{0:0.0}x}" Foreground="White" VerticalAlignment="Center" FontSize="12" Width="30" TextAlignment="Center"/>
             <Button Command="{Binding SpeedUpCommand}" Classes="ControlButton">
               <PathIcon Data="{StaticResource SpeedUpIcon}" Width="14" Height="14" Foreground="White"/>
             </Button>
           </StackPanel>

           <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
             <Button Command="{Binding SkipBackwardPercentCommand}" Classes="ControlButton">
               <PathIcon Data="{StaticResource JumpBackwardIcon}" Width="18" Height="18" Foreground="White"/>
             </Button>
             <Button Command="{Binding SkipBackwardCommand}" Classes="ControlButton">
               <PathIcon Data="{StaticResource SkipBackwardIcon}" Width="18" Height="18" Foreground="White"/>
             </Button>

             <Panel>
                <Button Command="{Binding PlayCommand}" IsVisible="{Binding !IsPlaying}" Classes="PlayButton">
                  <PathIcon Data="{StaticResource PlayIcon}" Width="24" Height="24" Foreground="White" Margin="3,0,0,0"/>
                </Button>
                <Button Command="{Binding PauseCommand}" IsVisible="{Binding IsPlaying}" Classes="PlayButton">
                  <PathIcon Data="{StaticResource PauseIcon}" Width="24" Height="24" Foreground="White"/>
                </Button>
             </Panel>

             <Button Command="{Binding SkipForwardCommand}" Classes="ControlButton">
               <PathIcon Data="{StaticResource SkipForwardIcon}" Width="18" Height="18" Foreground="White"/>
             </Button>
             <Button Command="{Binding SkipForwardPercentCommand}" Classes="ControlButton">
               <PathIcon Data="{StaticResource JumpForwardIcon}" Width="18" Height="18" Foreground="White"/>
             </Button>

             <Button Command="{Binding StopCommand}" Classes="StopButton" Margin="5,0,0,0">
               <PathIcon Data="{StaticResource StopIcon}" Width="20" Height="20" Foreground="White"/>
             </Button>
             <Button Command="{Binding ToggleLoopCommand}" Classes="LoopButton" Margin="5,0,0,0">
               <PathIcon Data="{StaticResource RepeatIcon}" Width="20" Height="20" 
                         Foreground="{Binding IsLoopEnabled, Converter={StaticResource BoolToAccentIconBrushConverter}}"
                         Opacity="{Binding IsLoopEnabled, Converter={StaticResource BoolToOpacityActiveConverter}}"/>
             </Button>
           </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
              <Border Padding="5" Margin="0,0,10,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <TextBlock Text="{Binding Position, StringFormat={}{0:hh\\:mm\\:ss}}" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <TextBlock Text="/" Foreground="#66ffffff" FontSize="11" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding Duration, StringFormat={}{0:hh\\:mm\\:ss}}" Foreground="#88ffffff" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
              </Border>

              <Border Padding="5,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <PathIcon Data="{StaticResource VolumeIcon}" Width="14" Height="14" Foreground="White" VerticalAlignment="Center"/>
                  <Slider Value="{Binding Volume}" Minimum="0" Maximum="100" Width="100" 
                          Classes="VolumeSlider"
                          Height="32" VerticalAlignment="Center" 
                          Margin="0,-12,0,0"
                          Foreground="#D6A23A"/>
                </StackPanel>
              </Border>

              <Button Command="{Binding ToggleAudioMenuCommand}" Classes="ControlButton" IsVisible="{Binding HasAudioTracks}" VerticalAlignment="Center">
               <StackPanel Orientation="Horizontal" Spacing="5">
                 <PathIcon Data="{StaticResource AudioIcon}" Width="14" Height="14" Foreground="White"/>
                 <TextBlock Text="{Binding AudioButtonLabel}" FontSize="11" VerticalAlignment="Center"/>
               </StackPanel>
             </Button>
             <Button Command="{Binding ToggleSubtitleMenuCommand}" Classes="ControlButton" IsVisible="{Binding HasSubtitleTracks}">
               <StackPanel Orientation="Horizontal" Spacing="5">
                 <PathIcon Data="{StaticResource SubtitlesIcon}" Width="14" Height="14" Foreground="White"/>
                 <TextBlock Text="{Binding SubsButtonLabel}" FontSize="11" VerticalAlignment="Center"/>
               </StackPanel>
             </Button>
             <!--
             <Button Command="{Binding DumpSubtitleDebugCommand}" Classes="ControlButton" VerticalAlignment="Center">
               <TextBlock Text="{Binding DumpButtonLabel}" FontSize="11" VerticalAlignment="Center"/>
             </Button>
             -->
             <Button Command="{Binding ToggleFullscreenCommand}" Classes="ControlButton">
               <PathIcon Data="{StaticResource FullscreenIcon}" Width="14" Height="14" Foreground="White"/>
             </Button>
           </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <Border IsVisible="{Binding IsTrackMenuOpen}"
            VerticalAlignment="Bottom"
            Margin="40,0,40,180"
            CornerRadius="12"
            Padding="15"
            Background="#ee1a1a1a"
            MaxWidth="300"
            HorizontalAlignment="Right">
      <StackPanel Spacing="10">
        <DockPanel>
          <TextBlock Text="{Binding CurrentTrackTypeLabel}" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
          <Button Command="{Binding CloseTrackMenuCommand}"
                  Background="Transparent" BorderThickness="0"
                  Width="30" Height="30" DockPanel.Dock="Right" HorizontalAlignment="Right">
            <TextBlock Text="X" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Button>
        </DockPanel>

        <ScrollViewer MaxHeight="250">
          <StackPanel>
            <ListBox Background="Transparent" BorderThickness="0"
                     ItemsSource="{Binding AudioTracks}"
                     IsVisible="{Binding CurrentTrackType, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Audio'}">
               <ListBox.ItemTemplate>
                 <DataTemplate>
                   <Button Command="{Binding #PlayerRoot.((vm:VideoPlayerViewModel)DataContext).SelectTrackCommand}"
                           CommandParameter="{Binding}"
                           Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Padding="5">
                     <TextBlock Text="{Binding Title}" Foreground="White"/>
                   </Button>
                 </DataTemplate>
               </ListBox.ItemTemplate>
            </ListBox>

            <ListBox Background="Transparent" BorderThickness="0"
                     ItemsSource="{Binding SubtitleTracks}"
                     IsVisible="{Binding CurrentTrackType, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Subtitle'}">
               <ListBox.ItemTemplate>
                 <DataTemplate>
                   <Button Command="{Binding #PlayerRoot.((vm:VideoPlayerViewModel)DataContext).SelectTrackCommand}"
                           CommandParameter="{Binding}"
                           Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch" Padding="5">
                     <TextBlock Text="{Binding Title}" Foreground="White"/>
                   </Button>
                 </DataTemplate>
               </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </ScrollViewer>
      </StackPanel>
    </Border>

    <Grid Background="#CC000000"
          IsVisible="{Binding IsDependencyOverlayVisible}"
          ZIndex="1000">
      <Border Background="#252526"
              BorderBrush="#4a4a4a"
              BorderThickness="2"
              CornerRadius="8"
              Padding="40,30"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              MinWidth="360"
              MaxWidth="720"
              BoxShadow="0 10 30 0 Black">
        <StackPanel Spacing="20" HorizontalAlignment="Center">
          <ProgressBar Width="260"
                       Height="8"
                       IsIndeterminate="True"
                       IsVisible="{Binding IsDependencyCheckInProgress}"/>

          <Border Width="60"
                  Height="60"
                  CornerRadius="30"
                  BorderThickness="4"
                  BorderBrush="#dc3545"
                  HorizontalAlignment="Center"
                  x:Name="DependencyErrorBorder"
                  IsVisible="{Binding IsDependencyErrorVisible}">
            <Border.Styles>
              <Style Selector="Border#DependencyErrorBorder">
                <Style.Animations>
                  <Animation Duration="0:0:1" IterationCount="Infinite" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                      <Setter Property="Opacity" Value="0.3"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                      <Setter Property="Opacity" Value="1.0"/>
                    </KeyFrame>
                  </Animation>
                </Style.Animations>
              </Style>
            </Border.Styles>
          </Border>

          <TextBlock Text="{Binding DependencyOverlayMessage}"
                     FontSize="20"
                     FontWeight="SemiBold"
                     Foreground="White"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     MaxWidth="640"/>
        </StackPanel>
      </Border>
    </Grid>

  </Panel>

</Window>
